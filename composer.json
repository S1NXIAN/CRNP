{
    "name": "s1nxian/crnp",
    "description": "CRATES N' PLATES — diner management web app (PHP 8.2 + Firebase RTDB).",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-fileinfo": "*",
        "ext-openssl": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.88",
        "phpstan/phpstan": "^1.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "config.php",
            "firebaseRDB.php",
            "db.php",
            "includes/functions.php",
            "includes/auth.php",
            "mailer.php"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "lint":    "php -d memory_limit=1G vendor/bin/php-cs-fixer fix --dry-run --diff --no-interaction",
        "format":  "php -d memory_limit=1G vendor/bin/php-cs-fixer fix --no-interaction",
        "analyse": "php -d memory_limit=1G vendor/bin/phpstan analyse --no-progress",
        "smoke":   "php tests/smoke_token.php && php tests/indexed_rules.php"
    },
    "scripts-descriptions": {
        "lint":    "Check code style without applying changes",
        "format":  "Apply code style fixes",
        "analyse": "Run PHPStan static analysis",
        "smoke":   "Run offline smoke tests"
    }
}
