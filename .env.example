# CRNP env — cp .env.example .env, fill values. Never commit .env.
# Service-account JSON must stay on ONE line (loader parses line-by-line).

# Firebase Realtime Database URL, verbatim from Console (regional *.firebasedatabase.app).
FIREBASE_DATABASE_URL="https://your-db-default-rtdb.asia-southeast1.firebasedatabase.app"
# Gmail address sending OTP/receipt mail via the Gmail API (HTTPS).
GMAIL_ADDRESS="your@gmail.com"
# Gmail API OAuth: create a client, consent once with the gmail.send scope,
# exchange the code for a refresh token (see README § Gmail API mail).
# Consent URL template (replace <CLIENT_ID>, open in browser, approve, copy code=):
# https://accounts.google.com/o/oauth2/v2/auth?client_id=<CLIENT_ID>&redirect_uri=http://localhost&response_type=code&scope=https://www.googleapis.com/auth/gmail.send&access_type=offline&prompt=consent
# Exchange template (replace <CODE>, <CLIENT_ID>, <SECRET>; run locally):
# curl -s -X POST https://oauth2.googleapis.com/token -d code=<CODE> -d client_id=<CLIENT_ID> -d client_secret=<SECRET> -d redirect_uri=http://localhost -d grant_type=authorization_code
GOOGLE_CLIENT_ID="your-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-oauth-client-secret"
GMAIL_REFRESH_TOKEN="your-refresh-token"
# Optional From: header override; defaults to GMAIL_ADDRESS.
MAIL_FROM="your@gmail.com"
DEV_SHOW_OTP="0"

# Production only (Render env var; omit locally): full service-account JSON, single line.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
