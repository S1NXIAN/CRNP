parameters:
    level: 4
    phpVersion: 80200
    paths:
        - app
        - includes
        - user
        - cashier
        - kitchen
        - admin
        - config.php
        - db.php
        - firebaseRDB.php
        - mailer.php
        - init.php
        - index.php
    excludePaths:
        # Vendored, legacy PHP 5.5 era library.
        - PHPMailer
    bootstrapFiles:
        - config.php
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # Procedural entry-points set super-globals / response headers; static
        # analysis can't see the side effects, so we mute the resulting noise.
        - '#Cannot access offset.*on mixed#'
        - '#Parameter .* of method .* expects .*, .* given#'
        # Mailer / form helpers accept loose inputs by design.
        - '#Function sendOTP|sendMail|sendOrderReceipt|sendBookingReceipt has no return type#'
        # auth/guards touch $_SESSION; that's expected.
        -
            message: '#Cannot access offset .* on .*\|null#'
            path: includes/auth.php
